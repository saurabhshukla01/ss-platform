# =========================================================
# PYTHON / FASTAPI
# =========================================================

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# Environment files / secrets
.env
.env.*
!.env.example

# Python packaging
*.egg
*.egg-info/
dist/
build/
wheels/
pip-wheel-metadata/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking / lint cache
.mypy_cache/
.pyre/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Logs
*.log
logs/


# =========================================================
# FASTAPI / DATABASE / LOCAL FILES
# =========================================================

# Uploaded files
backend/uploads/*
!backend/uploads/.gitkeep

# Local database files
*.db
*.sqlite
*.sqlite3

# Alembic generated cache
**/__pycache__/

# Local generated files
backend/tmp/
backend/temp/


